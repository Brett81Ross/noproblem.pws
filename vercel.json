{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/splash.html"
    },
    {
      "src": "/index.html",
      "dest": "/api/demo-shell"
    },
    {
      "handle": "filesystem"
    }
  ]
}
